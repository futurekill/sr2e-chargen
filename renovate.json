{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  "minimumReleaseAge": "7 days",
  "rangeStrategy": "pin",
  "vulnerabilityAlerts": { "minimumReleaseAge": null, "labels": ["security"] },
  "packageRules": [{ "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true }]
}
