{
  "name": "sr2e-chargen",
  "version": "0.0.0",
  "private": true,
  "description": "Hoi chummer! A Shadowrun 2nd Edition character generator and manager.",
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "bin": {
    "chargen": "server/cli.mjs"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "build": "vite build",
    "build:catalog": "node tools/build-catalog.mjs",
    "content:sync": "node tools/sync-content.mjs",
    "content:verify": "node tools/verify-content.mjs",
    "check:catalog": "node tools/check-catalog.mjs catalog",
    "test": "node --test test/",
    "test:postgres": "TEST_DATABASE_URL=postgres://postgres:test@127.0.0.1:55432/postgres node --test --test-force-exit --test-concurrency=1 test/",
    "test:mysql": "TEST_DATABASE_URL=mysql://root:test@127.0.0.1:53306/mysql node --test --test-force-exit --test-concurrency=1 test/",
    "test:mariadb": "TEST_DATABASE_URL=mysql://root:test@127.0.0.1:53307/mysql node --test --test-force-exit --test-concurrency=1 test/",
    "lint": "eslint server shared test tools"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "mysql2": "3.24.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "eslint": "10.15.0",
    "svelte": "5.57.3",
    "vite": "8.3.8"
  }
}
