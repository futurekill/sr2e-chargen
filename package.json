{
  "name": "sr2e-chargen",
  "version": "1.3.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/futurekill/sr2e-chargen"
  },
  "description": "Hoi, chummer! A Shadowrun 2nd Edition character generator and manager.",
  "type": "module",
  "engines": {
    "node": ">=26.13"
  },
  "bin": {
    "chargen": "server/cli.mjs"
  },
  "scripts": {
    "start": "node server/main.mjs",
    "build": "vite build",
    "build:catalog": "node tools/build-catalog.mjs",
    "content:sync": "node tools/sync-content.mjs",
    "content:verify": "node tools/verify-content.mjs",
    "check:catalog": "node tools/check-catalog.mjs catalog",
    "test": "node --test --test-timeout=300000 test/",
    "test:postgres": "TEST_DATABASE_URL=postgres://postgres:test@127.0.0.1:55432/postgres node --test --test-timeout=300000 --test-force-exit --test-concurrency=1 test/",
    "test:mysql": "TEST_DATABASE_URL=mysql://root:test@127.0.0.1:53306/mysql node --test --test-timeout=300000 --test-force-exit --test-concurrency=1 test/",
    "test:mariadb": "TEST_DATABASE_URL=mysql://root:test@127.0.0.1:53307/mysql node --test --test-timeout=300000 --test-force-exit --test-concurrency=1 test/",
    "lint": "eslint server shared test tools",
    "a11y": "node tools/a11y-scan.mjs",
    "help:shots": "node tools/help-shots.mjs",
    "gen:textures": "node tools/gen-textures.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "fastify": "5.12.8",
    "fontkit": "2.0.4",
    "kysely": "0.29.9",
    "mysql2": "3.24.6",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "eslint": "10.15.0",
    "pdfjs-dist": "6.5.438",
    "puppeteer-core": "25.17.0",
    "svelte": "5.57.3",
    "vite": "8.3.8"
  }
}
